# Server Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/punjabi-ai-podcasts

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Google Cloud Storage
GCS_BUCKET_NAME=punjabi-ai-podcasts

# Google Document AI
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_LOCATION=us

# Google Text-to-Speech
TTS_VOICE_ENGLISH=en-US-Neural2-D
TTS_VOICE_PUNJABI=pa-IN-Standard-A

# Google Vertex AI
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-pro

# Google Drive API
GOOGLE_DRIVE_CLIENT_ID=your-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Panjab Digital Library API
PANJAB_DIGILIB_API_URL=https://panjabdigilib.org/api
PANJAB_DIGILIB_API_KEY=your-api-key

# Distribution Platforms
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret

APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=your-private-key

YOUTUBE_CLIENT_ID=your-client-id
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/auth/youtube/callback

# File Upload Configuration
MAX_FILE_SIZE=52428800 # 50MB

# Logging Configuration
LOG_LEVEL=info