{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "prefer-const": "error",
    "no-var": "error",
    "prefer-template": "error",
    "prefer-arrow-callback": "warn",
    "object-shorthand": "warn",
    "no-console": "warn",
    "no-unused-vars": "error",
    "no-undef": "error",
    "no-trailing-spaces": "error",
    "semi": ["error", "always"]
  }
}
